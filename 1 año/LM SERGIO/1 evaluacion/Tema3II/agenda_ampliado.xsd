<?xml version="1.0" encoding="UTF-8"?>
<!--Ivan Poyda-->
 <xs:schema xmlns:xs = "http://www.w3.org/2001/XMLSchema">

    <xs:element name = "agenda_ampliado">
        <xs:complexType>
            <xs:sequence>

                <xs:element name = "situacion">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name = "estudiante" type = "xs:string"/>
                            <xs:element name = "trabajador" type = "xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name = "nombre_completo">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name = "nombre" type = "xs:string"/>
                            <xs:element name = "apellido1" type = "xs:string"/>
                            <xs:element name = "apellido2" type = "xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name = "apodo"/>
                <xs:element name = "mail"/>
                
            </xs:sequence>
        </xs:complexType>       
    </xs:element>

 </xs:schema>