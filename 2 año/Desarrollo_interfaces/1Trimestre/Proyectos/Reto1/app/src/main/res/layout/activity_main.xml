<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView como raíz: permite hacer scroll vertical cuando no caben todos los componentes en pantalla -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- LinearLayout vertical con alto wrap_content para que crezca libremente dentro del ScrollView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="WebViewLayout">

<!-- Título principal: usa 'sp' para adaptarse al tamaño de letra del móvil (accesibilidad) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_componentes"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtítulo de la primera sección; layout_marginTop en 'dp' para separarlo del título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/componentes_mostrar_informacion"
            android:textStyle="bold" />

        <!-- TextView informativo: todos los textos están centralizados en res/values/strings.xml -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/texto_textview_ejemplo"
            android:textSize="12sp" />

        <!-- CardView de 100dp con radio 50dp (la mitad): recorta la imagen en círculo en cualquier versión de Android -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp">

            <!-- ImageView con contentDescription obligatorio para accesibilidad (TalkBack) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_imagen_ejemplo"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/progreso_ejemplo" />

        <!-- ProgressBar con estilo horizontal para mostrar un porcentaje de carga (50 de 100) -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/titulo_videoview" />

        <!-- VideoView: contenedor para reproducir vídeo (solo visual en el Reto 1) -->
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/titulo_webview" />

        <!-- WebView: hueco donde MainActivity carga la web de developer.android.com -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            tools:ignore="WebViewLayout" />

        <!-- Inicio de la segunda sección: controles con los que interactúa el usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/componentes_entrada_interaccion"
            android:textStyle="bold" />

        <!-- EditText: caja de texto con minHeight="48dp" (tamaño táctil mínimo accesible) -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:hint="@string/hint_introduce_nombre"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/selecciona_tecnologias" />

        <!-- CheckBox: permiten marcar varias opciones independientes a la vez -->
        <CheckBox
            android:id="@+id/cbAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tecnologia_android" />

        <CheckBox
            android:id="@+id/cbReact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tecnologia_react" />

        <CheckBox
            android:id="@+id/cbFlutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tecnologia_flutter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/selecciona_modalidad" />

        <!-- RadioGroup: agrupa RadioButtons para que solo se pueda elegir una opción excluyente -->
        <RadioGroup
            android:id="@+id/rgModalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbPresencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/modalidad_presencial" />

            <RadioButton
                android:id="@+id/rbOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modalidad_online" />

            <RadioButton
                android:id="@+id/rbMixta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modalidad_mixta" />
        </RadioGroup>

        <!-- SwitchCompat: interruptor de encendido/apagado para activar o desactivar una opción -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNotificaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/notificaciones" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/selecciona_curso" />

        <!-- Spinner: desplegable relleno desde strings.xml sin necesitar código Kotlin -->
        <Spinner
            android:id="@+id/spinnerCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:entries="@array/lista_cursos"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/txtNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nivel_seleccionado_50" />

        <!-- SeekBar: barra deslizante para que el usuario elija un valor entre 0 y 100 -->
        <SeekBar
            android:id="@+id/seekNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50" />

        <!-- Botones principales de acción (el segundo replica la captura del Reto 1) -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/guardar_informacion" />

        <Button
            android:id="@+id/btnGuardar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guardar_informacion" />

        <!-- TextView inferior donde se mostrará el resumen al darle funcionalidad en el Reto 5 -->
        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="24dp"
            android:text="@string/resultado_inicial" />

    </LinearLayout>
</ScrollView>
