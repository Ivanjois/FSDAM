<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_my_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cabecera de la tarjeta: imagen programática + bloque título/subtítulo alineados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgCard"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_imagen_marco"
            android:contentDescription="@string/cd_my_card_imagen_defecto"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_combate_estelar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/my_card_titulo_defecto"
                android:textColor="@color/texto_principal"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/my_card_subtitulo_defecto"
                android:textColor="@color/texto_acento"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Descripción flexible -->
    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/my_card_descripcion_defecto"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp" />

    <!-- Botón de acción accesible (>= 48dp de alto) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_boton_secundario"
        android:minHeight="48dp"
        android:text="@string/my_card_boton_defecto"
        android:textAllCaps="false"
        android:textColor="@color/texto_principal"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
